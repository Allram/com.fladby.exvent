  "pair": [
    {
      "id": "setup"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Connection",
        "no": "Tilkobling"
      },
      "children": [
        {
          "id": "address",
          "type": "text",
          "value": "0.0.0.0",
          "label": {
            "en": "IP address",
            "no": "IP-adresse"
          },
          "hint": {
            "en": "The fixed IP address of the Freeway WEB adapter on your network.",
            "no": "Den faste IP-adressen Freeway WEB-adapteren har i nettverket ditt."
          }
        },
        {
          "id": "port",
          "type": "number",
          "value": 502,
          "step": 1,
          "label": {
            "en": "Port",
            "no": "Port"
          },
          "hint": {
            "en": "Modbus TCP port of the Freeway WEB adapter. This is 502 on a standard installation.",
            "no": "Modbus TCP-porten til Freeway WEB-adapteren. Denne er 502 på et standardoppsett."
          }
        },
        {
          "id": "unitId",
          "type": "number",
          "value": 1,
          "min": 1,
          "max": 255,
          "step": 1,
          "label": {
            "en": "Modbus unit ID",
            "no": "Modbus-enhets-ID"
          },
          "hint": {
            "en": "A Freeway WEB adapter presents the unit on ID 1. Only change this if your setup differs.",
            "no": "En Freeway WEB-adapter presenterer aggregatet på ID 1. Endre bare hvis oppsettet ditt avviker."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Overpressure",
        "no": "Overtrykk"
      },
      "children": [
        {
          "id": "fireplace_duration_minutes",
          "type": "number",
          "label": {
            "en": "Overpressure duration",
            "no": "Varighet for overtrykk"
          },
          "hint": {
            "en": "How many minutes overpressure stays active before the unit returns to normal operation. Stored on the unit when changed, and follows changes made on the unit's panel.",
            "no": "Hvor mange minutter overtrykk er aktiv før aggregatet går tilbake til normal drift. Lagres på aggregatet ved endring, og følger endringer gjort på panelet."
          },
          "value": 10,
          "min": 1,
          "max": 60,
          "units": {
            "en": "min",
            "no": "min"
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Season control",
        "no": "Sesongstyring"
      },
      "children": [
        {
          "id": "heating_allowed",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Heating allowed",
            "no": "Varme tillatt"
          },
          "hint": {
            "en": "Whether the unit may heat the supply air. Turn off in summer so a cold night does not start heating. Stored on the unit.",
            "no": "Om aggregatet får varme tilluften. Slå av om sommeren, så en kald natt ikke starter oppvarming. Lagres på aggregatet."
          }
        },
        {
          "id": "cooling_allowed",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Cooling allowed",
            "no": "Kjøling tillatt"
          },
          "hint": {
            "en": "Whether the unit may cool the supply air. Turn off outside summer so a warm spell does not start cooling. Stored on the unit.",
            "no": "Om aggregatet får kjøle tilluften. Slå av utenom sommeren, så en varm periode ikke starter kjøling. Lagres på aggregatet."
          }
        },
        {
          "id": "heating_block_temperature",
          "type": "number",
          "value": 25,
          "min": -5,
          "max": 25,
          "step": 0.5,
          "units": {
            "en": "°C",
            "no": "°C"
          },
          "label": {
            "en": "Block heating above",
            "no": "Sperr varme over"
          },
          "hint": {
            "en": "Heating is blocked while the outdoor temperature is above this. Stored on the unit.",
            "no": "Varme sperres så lenge utetemperaturen er over denne grensen. Lagres på aggregatet."
          }
        },
        {
          "id": "cooling_block_temperature",
          "type": "number",
          "value": 16,
          "min": 5,
          "max": 40,
          "step": 0.5,
          "units": {
            "en": "°C",
            "no": "°C"
          },
          "label": {
            "en": "Block cooling below",
            "no": "Sperr kjøling under"
          },
          "hint": {
            "en": "Cooling is blocked while the outdoor temperature is below this. Stored on the unit.",
            "no": "Kjøling sperres så lenge utetemperaturen er under denne grensen. Lagres på aggregatet."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Service reminder",
        "no": "Servicepåminnelse"
      },
      "children": [
        {
          "id": "filter_interval_days",
          "type": "number",
          "label": {
            "en": "Days between reminders",
            "no": "Dager mellom påminnelser"
          },
          "hint": {
            "en": "Number of days between service reminders. Exvent recommends changing the filters every six months. Stored on the unit when changed.",
            "no": "Antall døgn mellom hver servicepåminnelse. Exvent anbefaler filterbytte hvert halvår. Lagres på aggregatet ved endring."
          },
          "value": 180,
          "min": 1,
          "max": 365,
          "units": {
            "en": "days",
            "no": "døgn"
          }
        }
      ]
    }
  ]
}
