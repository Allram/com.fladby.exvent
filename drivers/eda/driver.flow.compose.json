{
  "actions": [
    {
      "id": "heatingcoil_eda",
      "title": {
        "en": "Allow or block heating",
        "no": "Tillat eller sperr varme"
      },
      "titleFormatted": {
        "en": "[[heatingcoil]] heating",
        "no": "[[heatingcoil]] varme"
      },
      "hint": {
        "en": "Allows or blocks heating of the supply air. Stored on the unit.",
        "no": "Tillater eller sperrer oppvarming av tilluften. Lagres på aggregatet."
      },
      "args": [
        {
          "type": "dropdown",
          "name": "heatingcoil",
          "values": [
            {
              "id": "1",
              "label": {
                "en": "Allow",
                "no": "Tillat"
              }
            },
            {
              "id": "0",
              "label": {
                "en": "Block",
                "no": "Sperr"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "set-temperature_eda",
      "title": {
        "en": "Set target temperature",
        "no": "Sett ønsket temperatur"
      },
      "titleFormatted": {
        "en": "Set target temperature to [[temperature]]",
        "no": "Sett ønsket temperatur til [[temperature]]"
      },
      "args": [
        {
          "type": "range",
          "name": "temperature",
          "min": 10,
          "max": 30,
          "step": 0.5,
          "label": " °C",
          "labelDecimals": 1
        }
      ]
    },
    {
      "id": "status-mode_eda",
      "title": {
        "en": "Set mode",
        "no": "Sett modus"
      },
      "titleFormatted": {
        "en": "Set mode to [[mode]]",
        "no": "Sett modus til [[mode]]"
      },
      "args": [
        {
          "type": "dropdown",
          "name": "mode",
          "values": [
            {
              "id": "0",
              "label": {
                "en": "Home",
                "no": "Hjemme"
              }
            },
            {
              "id": "1",
              "label": {
                "en": "Away",
                "no": "Borte"
              }
            },
            {
              "id": "2",
              "label": {
                "en": "Overpressure",
                "no": "Overtrykk"
              }
            },
            {
              "id": "3",
              "label": {
                "en": "Boost",
                "no": "Boost"
              }
            },
            {
              "id": "4",
              "label": {
                "en": "Off",
                "no": "Av"
              }
            }
          ]
        }
      ],
      "hint": {
        "en": "Boost ends by itself after the boost duration, and overpressure after the overpressure duration in the device settings. Off stops the unit.",
        "no": "Boost slutter av seg selv etter boostvarigheten, og overtrykk etter varigheten i enhetsinnstillingene. Av stopper aggregatet."
      }
    },
    {
      "id": "set-cooling_eda",
      "title": {
        "en": "Allow or block cooling",
        "no": "Tillat eller sperr kjøling"
      },
      "titleFormatted": {
        "en": "[[allowed]] cooling",
        "no": "[[allowed]] kjøling"
      },
      "hint": {
        "en": "Allows or blocks cooling of the supply air. Stored on the unit.",
        "no": "Tillater eller sperrer kjøling av tilluften. Lagres på aggregatet."
      },
      "args": [
        {
          "type": "dropdown",
          "name": "allowed",
          "values": [
            {
              "id": "1",
              "label": {
                "en": "Allow",
                "no": "Tillat"
              }
            },
            {
              "id": "0",
              "label": {
                "en": "Block",
                "no": "Sperr"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "set-heating-block-temperature_eda",
      "title": {
        "en": "Block heating above",
        "no": "Sperr varme over"
      },
      "titleFormatted": {
        "en": "Block heating above [[temperature]]",
        "no": "Sperr varme over [[temperature]]"
      },
      "hint": {
        "en": "Heating is blocked while the outdoor temperature is above this temperature. Stored on the unit.",
        "no": "Varme sperres så lenge utetemperaturen er over denne grensen. Lagres på aggregatet."
      },
      "args": [
        {
          "type": "range",
          "name": "temperature",
          "min": -5,
          "max": 25,
          "step": 0.5,
          "label": " °C",
          "labelDecimals": 1
        }
      ]
    },
    {
      "id": "set-cooling-block-temperature_eda",
      "title": {
        "en": "Block cooling below",
        "no": "Sperr kjøling under"
      },
      "titleFormatted": {
        "en": "Block cooling below [[temperature]]",
        "no": "Sperr kjøling under [[temperature]]"
      },
      "hint": {
        "en": "Cooling is blocked while the outdoor temperature is below this temperature. Stored on the unit.",
        "no": "Kjøling sperres så lenge utetemperaturen er under denne grensen. Lagres på aggregatet."
      },
      "args": [
        {
          "type": "range",
          "name": "temperature",
          "min": 5,
          "max": 40,
          "step": 0.5,
          "label": " °C",
          "labelDecimals": 1
        }
      ]
    },
    {
      "id": "set-fan-level_eda",
      "$filter": "capabilities=fanspeed_level_set",
      "title": {
        "en": "Set fan level",
        "no": "Sett viftenivå"
      },
      "titleFormatted": {
        "en": "Set fan level to [[level]]",
        "no": "Sett viftenivå til [[level]]"
      },
      "hint": {
        "en": "Sets the unit's fan level, just like its panel. Only for units with EC fans. Boost, overpressure and a running heat pump can raise it for a while.",
        "no": "Stiller inn viftenivået på aggregatet, akkurat som panelet. Bare for aggregater med EC-vifter. Boost, overtrykk og varmepumpe i drift kan øke det en stund."
      },
      "args": [
        {
          "type": "range",
          "name": "level",
          "min": 20,
          "max": 100,
          "step": 1,
          "label": "%"
        }
      ]
    },
    {
      "id": "set-overpressure-duration_eda",
      "title": {
        "en": "Set overpressure duration",
        "no": "Sett varighet for overtrykk"
      },
      "titleFormatted": {
        "en": "Set overpressure duration to [[minutes]]",
        "no": "Sett varighet for overtrykk til [[minutes]]"
      },
      "hint": {
        "en": "How many minutes overpressure stays active before the unit returns to normal operation. Stored on the unit, and applies the next time overpressure starts.",
        "no": "Hvor mange minutter overtrykket varer før aggregatet går tilbake til normal drift. Lagres på aggregatet, og gjelder neste gang overtrykk starter."
      },
      "args": [
        {
          "type": "range",
          "name": "minutes",
          "min": 1,
          "max": 60,
          "step": 1,
          "label": " min"
        }
      ]
    },
    {
      "id": "start-boost_eda",
      "title": {
        "en": "Start boost for a number of minutes",
        "no": "Start boost i et antall minutter"
      },
      "titleFormatted": {
        "en": "Start boost for [[minutes]]",
        "no": "Start boost i [[minutes]]"
      },
      "hint": {
        "en": "Sets the boost duration on the unit and starts boost. The duration is kept for the next boost too.",
        "no": "Setter boostvarigheten på aggregatet og starter boost. Varigheten gjelder også neste boost."
      },
      "args": [
        {
          "type": "range",
          "name": "minutes",
          "min": 1,
          "max": 60,
          "step": 1,
          "label": " min"
        }
      ]
    },
    {
      "id": "start-overpressure_eda",
      "title": {
        "en": "Start overpressure for a number of minutes",
        "no": "Start overtrykk i et antall minutter"
      },
      "titleFormatted": {
        "en": "Start overpressure for [[minutes]]",
        "no": "Start overtrykk i [[minutes]]"
      },
      "hint": {
        "en": "Sets the overpressure duration on the unit and starts overpressure. The duration is kept for the next time too.",
        "no": "Setter varigheten for overtrykk på aggregatet og starter overtrykk. Varigheten gjelder også neste gang."
      },
      "args": [
        {
          "type": "range",
          "name": "minutes",
          "min": 1,
          "max": 60,
          "step": 1,
          "label": " min"
        }
      ]
    }
  ],
