    {
      "id": "set-heating-block-temperature_eda",
      "title": {
        "en": "Block heating above",
        "no": "Sperr varme over"
      },
      "titleFormatted": {
        "en": "Block heating above [[temperature]] °C",
        "no": "Sperr varme over [[temperature]] °C"
      },
      "hint": {
        "en": "Heating is blocked while the outdoor temperature is above this. Stored on the unit.",
        "no": "Varme sperres så lenge utetemperaturen er over denne grensen. Lagres på aggregatet."
      },
      "args": [
        {
          "type": "range",
          "name": "temperature",
          "min": -5,
          "max": 25,
          "step": 0.5
        }
      ]
    },
    {
      "id": "set-cooling-block-temperature_eda",
      "title": {
        "en": "Block cooling below",
        "no": "Sperr kjøling under"
      },
      "titleFormatted": {
        "en": "Block cooling below [[temperature]] °C",
        "no": "Sperr kjøling under [[temperature]] °C"
      },
      "hint": {
        "en": "Cooling is blocked while the outdoor temperature is below this. Stored on the unit.",
        "no": "Kjøling sperres så lenge utetemperaturen er under denne grensen. Lagres på aggregatet."
      },
      "args": [
        {
          "type": "range",
          "name": "temperature",
          "min": 5,
          "max": 40,
          "step": 0.5
        }
      ]
    },
    {
      "id": "set-fan-level_eda",
      "title": {
        "en": "Set fan level",
        "no": "Sett viftenivå"
      },
      "titleFormatted": {
        "en": "Set fan level to [[level]] %",
        "no": "Sett viftenivå til [[level]] %"
      },
      "hint": {
        "en": "Sets the fan level selected on the unit, as on its panel. Boost, overpressure and a running heat pump can raise it for a while.",
        "no": "Setter viftenivået som er valgt på aggregatet, som på panelet. Boost, overtrykk og varmepumpe i drift kan øke det en stund."
      },
      "args": [
        {
          "type": "range",
          "name": "level",
          "min": 20,
          "max": 100,
          "step": 1
        }
      ]
    },
    {
      "id": "set-overpressure-duration_eda",
      "title": {
        "en": "Set overpressure duration",
        "no": "Sett varighet for overtrykk"
      },
      "titleFormatted": {
        "en": "Set overpressure duration to [[minutes]] min",
        "no": "Sett varighet for overtrykk til [[minutes]] min"
      },
      "hint": {
        "en": "How many minutes overpressure stays active before the unit returns to normal operation. Stored on the unit, and applies the next time overpressure starts.",
        "no": "Hvor mange minutter overtrykk er aktiv før aggregatet går tilbake til normal drift. Lagres på aggregatet, og gjelder neste gang overtrykk starter."
      },
      "args": [
        {
          "type": "range",
          "name": "minutes",
          "min": 1,
          "max": 60,
          "step": 1
        }
      ]
    }
