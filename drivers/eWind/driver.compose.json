  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Connection",
        "no": "Tilkobling"
      },
      "children": [
        {
          "id": "address",
          "type": "text",
          "value": "0.0.0.0",
          "label": {
            "en": "IP address",
            "no": "IP-adresse"
          },
          "hint": {
            "en": "The fixed IP address of the ventilation unit on your network.",
            "no": "Den faste IP-adressen aggregatet har i nettverket ditt."
          }
        },
        {
          "id": "port",
          "type": "number",
          "value": 502,
          "step": 1,
          "label": {
            "en": "Port",
            "no": "Port"
          },
          "hint": {
            "en": "Modbus TCP port of the ventilation unit. This is 502 on a standard installation.",
            "no": "Modbus TCP-porten til aggregatet. Denne er 502 på et standardoppsett."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Overpressure",
        "no": "Overtrykk"
      },
      "children": [
        {
          "id": "fireplace_duration_minutes",
          "type": "number",
          "label": {
            "en": "Overpressure duration",
            "no": "Varighet for overtrykk"
          },
          "hint": {
            "en": "How many minutes overpressure stays active before the unit returns to normal operation. Stored on the unit when changed.",
            "no": "Hvor mange minutter overtrykk er aktiv før aggregatet går tilbake til normal drift. Lagres på aggregatet ved endring."
          },
          "value": 10,
          "min": 1,
          "max": 60,
          "units": {
            "en": "min",
            "no": "min"
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Service reminder",
        "no": "Servicepåminnelse"
      },
      "children": [
        {
          "id": "filter_interval_days",
          "type": "number",
          "label": {
            "en": "Days between reminders",
            "no": "Dager mellom påminnelser"
          },
          "hint": {
            "en": "Number of days after a reset before the service reminder is raised. Stored on the unit when changed.",
            "no": "Antall døgn etter nullstilling før servicepåminnelsen gis. Lagres på aggregatet ved endring."
          },
          "value": 120,
          "min": 1,
          "max": 365,
          "units": {
            "en": "days",
            "no": "døgn"
          }
        }
      ]
    }
  ]
