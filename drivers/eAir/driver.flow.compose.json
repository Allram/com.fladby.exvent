              }
            },
            {
              "id": "0",
              "label": {
                "en": "Inactive",
                "no": "Inaktiv"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "heatingcoil_eAir",
      "title": {
        "en": "Set heating coil",
        "no": "Sett varmekolbe"
      },
      "titleFormatted": {
        "en": "Set Heating coil enabled to [[heatingcoil_eAir]]",
        "no": "Sett Varmekolbe aktivert til [[heatingcoil_eAir]]"
      },
      "hint": {
        "en": "Lets the unit use the heating coil, or keeps it from doing so.",
        "no": "Lar anlegget bruke varmekolben, eller hindrer det i å bruke den."
      },
      "args": [
        {
          "type": "dropdown",
          "name": "heatingcoil_eAir",
          "values": [
            {
              "id": "1",
              "label": {
                "en": "On",
                "no": "På"
              }
            },
            {
              "id": "0",
              "label": {
                "en": "Off",
                "no": "Av"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "set-temperature_eAir",
      "title": {
        "en": "Set target temperature",
        "no": "Sett ønsket temperatur"
      },
      "titleFormatted": {
        "en": "Set target temperature to [[temperature]]",
        "no": "Sett ønsket temperatur til [[temperature]]"
      },
      "args": [
        {
          "type": "range",
          "name": "temperature",
          "min": 15,
          "max": 22,
          "step": 1,
          "label": " °C"
        }
      ]
    },
    {
      "id": "status-mode_eAir",
      "title": {
        "en": "Set mode",
        "no": "Sett modus"
      },
      "titleFormatted": {
        "en": "Set mode to [[mode]]",
        "no": "Sett modus til [[mode]]"
      },
      "args": [
        {
          "type": "dropdown",
          "name": "mode",
          "values": [
            {
              "id": "0",
              "label": {
                "en": "Home",
                "no": "Hjemme"
              }
            },
            {
              "id": "1",
              "label": {
                "en": "Away",
                "no": "Borte"
              }
            },
            {
              "id": "2",
              "label": {
                "en": "Fireplace",
                "no": "Peismodus"
              }
            },
            {
              "id": "5",
              "label": {
                "en": "Enhanced ventilation",
                "no": "Forsterket ventilasjon"
              }
            },
            {
              "id": "3",
              "label": {
                "en": "Boost",
                "no": "Boost"
              }
            },
            {
              "id": "4",
              "label": {
                "en": "Off",
                "no": "Av"
              }
            }
          ]
        }
      ],
      "hint": {
        "en": "Boost ends by itself after the boost duration, and fireplace mode after the fireplace duration in the device settings. Enhanced ventilation stays on until the mode is changed. Off stops the unit.",
        "no": "Boost slutter av seg selv etter boostvarigheten, og peismodus etter varigheten i enhetsinnstillingene. Forsterket ventilasjon står til modus endres. Av stopper anlegget."
      }
    },
    {
      "id": "reset_filter_reminder_eAir",
      "title": {
        "en": "Reset filter change reminder",
        "no": "Nullstill varsel om filterbytte"
      },
      "titleFormatted": {
        "en": "Reset filter change reminder",
        "no": "Nullstill varsel om filterbytte"
      },
      "hint": {
        "en": "Resets the unit's filter/service day counter to 0. Use after replacing the filter.",
        "no": "Nullstiller anleggets dagteller for filter/service. Brukes etter filterbytte."
      }
    },
    {
      "id": "start-fireplace_eAir",
      "title": {
        "en": "Start fireplace mode for a number of minutes",
        "no": "Start peismodus i et antall minutter"
      },
      "titleFormatted": {
        "en": "Start fireplace mode for [[minutes]]",
        "no": "Start peismodus i [[minutes]]"
      },
      "hint": {
        "en": "Sets the fireplace duration on the unit and starts fireplace mode. The duration is kept for the next time too.",
        "no": "Setter varigheten for peismodus på anlegget og starter peismodus. Varigheten gjelder også neste gang."
      },
      "args": [
        {
          "type": "range",
          "name": "minutes",
          "min": 1,
          "max": 60,
          "step": 1,
          "label": " min"
        }
      ]
    }
  ],
