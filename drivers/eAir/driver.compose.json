  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Connection",
        "no": "Tilkobling"
      },
      "children": [
        {
          "id": "address",
          "type": "text",
          "value": "0.0.0.0",
          "label": {
            "en": "IP address",
            "no": "IP-adresse"
          },
          "hint": {
            "en": "The fixed IP address of the ventilation unit on your network.",
            "no": "Den faste IP-adressen ventilasjonsanlegget har i nettverket ditt."
          }
        },
        {
          "id": "port",
          "type": "number",
          "value": 502,
          "step": 1,
          "label": {
            "en": "Port",
            "no": "Port"
          },
          "hint": {
            "en": "Modbus TCP port of the ventilation unit. This is 502 on a standard installation.",
            "no": "Modbus TCP-porten til ventilasjonsanlegget. Denne er 502 på et standardoppsett."
          },
          "min": 1,
          "max": 65535
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Fireplace mode",
        "no": "Peismodus"
      },
      "children": [
        {
          "id": "fireplace_duration_minutes",
          "type": "number",
          "label": {
            "en": "Fireplace mode duration",
            "no": "Varighet for peismodus"
          },
          "hint": {
            "en": "How many minutes fireplace mode (overpressure) stays active before the unit returns to normal operation. Written to the ventilation unit when changed, and follows changes made on the unit panel.",
            "no": "Hvor mange minutter peismodus (overtrykk) er aktiv før anlegget går tilbake til normal drift. Skrives til ventilasjonsanlegget ved endring, og følger endringer gjort på panelet."
          },
          "value": 10,
          "min": 1,
          "max": 60,
          "units": {
            "en": "min",
            "no": "min"
          },
          "step": 1
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Filter",
        "no": "Filter"
      },
      "children": [
        {
          "id": "filter_interval_days",
          "type": "number",
          "label": {
            "en": "Days between filter changes",
            "no": "Dager mellom filterbytter"
          },
          "hint": {
            "en": "Number of days after a reset before the filter change reminder is raised. Written to the ventilation unit when changed, and follows changes made on the unit panel.",
            "no": "Antall dager etter nullstilling før varsel om filterbytte utløses. Skrives til ventilasjonsanlegget ved endring, og følger endringer gjort på panelet."
          },
          "value": 120,
          "min": 1,
          "max": 365,
          "units": {
            "en": "d",
            "no": "d"
          },
          "step": 1
        }
      ]
    }
  ]
